@import './base.css';

body {
    background-color: #F5F6FF;
}

.title {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 2rem;
}

.title > a > img,
.title > img {
    width: 5.3rem;
    height: 5.3rem;
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
}

.title > p {
    font-size: 3.6rem;
    font-family: 'JostSemiBold', sans-serif;
    color: #3C3E4C;
}

/* ==========================================
   УПРАВЛЕНИЕ МЕСЯЦЕМ И ГОДОМ
   ========================================== */
.month-controls {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 2rem;
    max-width: 128rem;
    margin-left: auto;
    margin-right: auto;
}

.calendar-page-selects {
    display: flex;
    gap: 0.4rem;
    align-items: center;
}

.calendar-page-select {
    font-size: 2.2rem;
    font-family: 'JostRegular', sans-serif;
    color: #3C3E4C;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0.2rem 0.6rem;
    cursor: pointer;
    outline: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
}

.calendar-page-select:hover,
.calendar-page-select:focus {
    background-color: #EAEBF8;
    border-color: #BEC4E3;
}

.calendar-page-btn {
    background: none;
    border: none;
    font-size: 4rem;
    font-weight: 300;
    color: #636AA3;
    cursor: pointer;
    line-height: 0.8;
    padding: 0 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, transform 0.15s ease;
}

.calendar-page-btn:hover {
    color: #3C3E4C;
    transform: scale(1.15);
}

/* ==========================================
   СЕТКА КАЛЕНДАРЯ
   ========================================== */
.calendar-wrapper {
    background-color: #FFF;
    padding: 0;
    box-shadow: 26rem 25rem 75rem #E6E7F6;
    max-width: 128rem;
    margin-left: auto;
    margin-right: auto;
    overflow: hidden;
    border-left: 0.1rem solid #3C3E4C;
    margin-bottom: 4.6rem;
}

.calendar-header {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    border-bottom: 0.1rem solid #3C3E4C;
    border-top: 0.1rem solid #3C3E4C;
}

.week-day {
    font-family: 'RobotoMedium', sans-serif;
    font-size: 1.8rem;
    color: #3C3E4C;
    text-align: center;
    padding: 1.5rem;
    border-right: 0.1rem solid #3C3E4C;
    background-color: #F9FAFF;
}

.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
}

.day {
    min-height: 12rem;
    border-right: 0.1rem solid #3C3E4C;
    border-bottom: 0.1rem solid #3C3E4C;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: 1rem 1rem 0 0;
    position: relative;
    cursor: pointer;
    transition: background-color 0.2s ease;
}

.day:not(.day-today):hover {
    background-color: #F0F2FA;
}

.day.day-today:hover {
    background-color: #52598c;
}

.day-number {
    font-family: 'RobotoMedium', sans-serif;
    font-size: 2.4rem;
    color: #3C3E4C;
    margin-bottom: 1rem;
}

.day-markers {
    position: absolute;
    bottom: 3rem;
    right: 5rem;
    display: flex;
    gap: 0.5rem;
}

.marker {
    display: flex;
    gap: 0.5rem;
    flex-direction: column;
    align-items: center;
}

.marker img {
    width: 3.8rem;
    height: 3.8rem;
}

.marker-count {
    font-family: 'RobotoRegular', sans-serif;
    font-size: 2rem;
    color: #3C3E4C;
    min-width: 1.5rem;
    text-align: center;
}

.day.day-today {
    background-color: #636AA3;
}

.day.day-today .day-number,
.day.day-today .marker-count {
    color: white;
}

.day.prev-month .day-number,
.day.next-month .day-number,
.day.prev-month .marker-count,
.day.next-month .marker-count {
    color: #A8A9E3;
    opacity: 0.6;
}

/* ==========================================
   АДАПТИВНОСТЬ
   ========================================== */
@media (max-width: 1280px) {
    .calendar-wrapper {
        margin: 0 2rem 4rem;
    }

    .day {
        min-height: 10rem;
    }

    .day-number {
        font-size: 2rem;
    }

    .marker img {
        width: 3.2rem;
        height: 3.2rem;
    }

    .marker-count {
        font-size: 1.8rem;
    }

    .day-markers {
        bottom: 2rem;
        right: 4rem;
    }
}

@media (max-width: 1024px) {
    .calendar-wrapper {
        margin: 0 1rem 3rem;
    }

    .week-day {
        font-size: 1.6rem;
        padding: 1rem;
    }

    .day {
        min-height: 8rem;
        padding: 0.5rem 0.5rem 0 0;
    }

    .day-number {
        font-size: 1.8rem;
    }

    .marker img {
        width: 2.8rem;
        height: 2.8rem;
    }

    .marker-count {
        font-size: 1.6rem;
    }

    .day-markers {
        bottom: 1.5rem;
        right: 3rem;
    }
}

@media (max-width: 768px) {
    :root {
        font-size: 55%;
    }

    .calendar-wrapper {
        margin: 0 0.5rem 2rem;
        box-shadow: 0 1rem 3rem #E6E7F6;
    }

    .week-day {
        font-size: 1.2rem;
        padding: 0.8rem 0.5rem;
        word-break: break-word;
    }

    .day {
        min-height: 6rem;
        padding: 0.3rem 0.3rem 0 0;
    }

    .day-number {
        font-size: 1.4rem;
        margin-bottom: 0.5rem;
    }

    .marker,
    .day-markers {
        display: none;
    }
}

@media (max-width: 480px) {
    :root {
        font-size: 50%;
    }

    .week-day {
        font-size: 1rem;
        padding: 0.5rem 0.2rem;
    }

    .day {
        min-height: 5rem;
    }

    .day-number {
        font-size: 1.2rem;
    }
}
